#!/usr/bin/env bash

set -euo pipefail

start_time=$(date +%s%N)

function error() {
  echo " !     $*" >&2
  exit 1
}

function topic() {
  echo "-----> $*"
}

function indent() {
  c='s/^/       /'
  case $(uname) in
    Darwin) sed -l "$c";;
    *)      sed -u "$c";;
  esac
}

layers_dir="$1"
env_dir="$2/env"
plan_path="$3"
ffmpeg_url="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz"

ffmpeg_layer=$layers_dir/ffmpeg
mkdir -p $ffmpeg_layer
cd $ffmpeg_layer


if [ -x "$ffmpeg_layer/bin/ffmpeg" ]; then
    topic "Reusing existing ffmpeg"
else
    topic "Fetching ffmpeg"
    curl "$ffmpeg_url" -L -o- \
        | tar xJ --strip-components=1 -C "$ffmpeg_layer"
fi

cat > "${layers_dir}/ffmpeg.toml" << EOF
[types]
cache = true
launch = true
EOF

echo "ffmpeg buildpack was successful" | indent

exit 0
